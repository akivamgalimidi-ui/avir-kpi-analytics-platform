import * as XLSX from 'xlsx';
import type { ParsedData } from './parseWorkbook';

function sum<T>(rows: T[], field: keyof T): number {
  return rows.reduce((s, r) => s + (Number(r[field]) || 0), 0);
}

function grp<T>(arr: T[], key: (r: T) => string): Record<string, T[]> {
  return arr.reduce((acc, r) => { const k = key(r)||'Unknown'; (acc[k]=acc[k]||[]).push(r); return acc; }, {} as Record<string, T[]>);
}

function sheet(headers: string[], rows: unknown[][]): XLSX.WorkSheet {
  const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
  ws['!cols'] = headers.map(() => ({ wch: 22 }));
  return ws;
}

export function buildExcelExport(data: ParsedData, filteredOT: any[], filteredBonus: any[], filteredPPD: any[]): Blob {
  const wb = XLSX.utils.book_new();

  XLSX.utils.book_append_sheet(wb, sheet(['Field','Value'], [
    ['Filename', data.filename],
    ['File Size (KB)', (data.fileSize/1024).toFixed(1)],
    ['Parsed At', new Date(data.parsedAt).toLocaleString()],
    ['Sheets Detected', data.sheetsDetected.length],
    ['Facilities', data.facilities.length],
    ['Acq Groups', data.subgroups.length],
    ['Pay Periods', data.payPeriods.join(', ')],
    ['OT Rows', data.otRows.length],
    ['Bonus Rows', data.bonusRows.length],
    ['PPD Rows', data.ppdRows.length],
    ['Warnings', data.warnings.length],
  ]), 'Upload Summary');

  XLSX.utils.book_append_sheet(wb, sheet(
    ['Facility','Subgroup','Pay Cycle','Latest Period','Prior Period','Comparable Status'],
    data.facilities.map(f => [f.name, f.subgroup, f.payCycle, f.latestPeriod, f.priorPeriod, f.comparableStatus])
  ), 'Facility Mapping');

  const otByFac = grp(filteredOT, r => r.facility);
  XLSX.utils.book_append_sheet(wb, sheet(
    ['Facility','Subgroup','OT Dollars','OT Hours'],
    Object.entries(otByFac).map(([fac,rows]) => {
      const f = data.facilities.find(x=>x.name===fac);
      return [fac, f?.subgroup||'', sum(rows,'otDollars'), sum(rows,'otHours')];
    }).sort((a,b)=>(b[2] as number)-(a[2] as number))
  ), 'OT by Facility');

  XLSX.utils.book_append_sheet(wb, sheet(
    ['Employee','Facility','Subgroup','Department','Position','Pay Period','OT Dollars','OT Hours'],
    filteredOT.map(r => [r.employee,r.facility,r.subgroup,r.department,r.position,r.payPeriod,r.otDollars,r.otHours])
  ), 'OT Detail');

  const bonusByFac = grp(filteredBonus, r => r.facility);
  XLSX.utils.book_append_sheet(wb, sheet(
    ['Facility','Subgroup','Bonus Dollars'],
    Object.entries(bonusByFac).map(([fac,rows]) => {
      const f = data.facilities.find(x=>x.name===fac);
      return [fac, f?.subgroup||'', sum(rows,'bonusDollars')];
    }).sort((a,b)=>(b[2] as number)-(a[2] as number))
  ), 'Bonus by Facility');

  XLSX.utils.book_append_sheet(wb, sheet(
    ['Employee','Facility','Subgroup','Bonus Type','Position','Pay Period','Bonus Dollars'],
    filteredBonus.map(r => [r.employee,r.facility,r.subgroup,r.bonusType,r.position,r.payPeriod,r.bonusDollars])
  ), 'Bonus Detail');

  XLSX.utils.book_append_sheet(wb, sheet(
    ['Facility','Subgroup','Metric Type','Pay Period','Value'],
    filteredPPD.map(r => [r.facility,r.subgroup,r.metricType,r.payPeriod,r.value])
  ), 'PPD Detail');

  const otByFac2 = grp(filteredOT, r=>r.facility);
  const bonusByFac2 = grp(filteredBonus, r=>r.facility);
  const rankings = data.facilities.map(f => {
    const ot = sum(otByFac2[f.name]||[], 'otDollars');
    const bonus = sum(bonusByFac2[f.name]||[], 'bonusDollars');
    return { ...f, ot, bonus, score: ot+bonus };
  }).sort((a,b)=>b.score-a.score);

  XLSX.utils.book_append_sheet(wb, sheet(
    ['Rank','Facility','Subgroup','Pay Cycle','OT $','Bonus $','Pressure Score','Comparable'],
    rankings.map((r,i) => [i+1, r.name, r.subgroup, r.payCycle, r.ot, r.bonus, r.score, r.comparableStatus])
  ), 'Labor Pressure Ranking');

  XLSX.utils.book_append_sheet(wb, sheet(
    ['Facility','Subgroup','Pay Cycle','Latest Period','Prior Period','Comparable'],
    data.facilities.map(f => [f.name, f.subgroup, f.payCycle, f.latestPeriod, f.priorPeriod, f.comparableStatus])
  ), 'Pay Cycle Mapping');

  XLSX.utils.book_append_sheet(wb, sheet(['Sheet','Parser Coverage'], Object.entries(data.parserCoverage).map(([k,v])=>[k,v])), 'Data Quality');
  XLSX.utils.book_append_sheet(wb, sheet(['#','Warning'], data.warnings.map((w,i)=>[i+1,w])), 'Parser Warnings');

  const buf = XLSX.write(wb, { type: 'array', bookType: 'xlsx' });
  return new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
}

export function downloadBlob(blob: Blob, filename: string) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  URL.revokeObjectURL(url);
}
